{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "attempt_id",
    "goal_sha256",
    "snapshot_sha256",
    "verdict",
    "requirements",
    "report_body"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "review_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "goal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "CONCERN",
        "REQUEST_CHANGES"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "report_body": {
      "type": "string",
      "minLength": 1
    }
  }
}
