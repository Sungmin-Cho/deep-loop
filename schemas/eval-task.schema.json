{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval-task.schema.json",
  "x-deep-loop-runtime": "evals/lib/validate.mjs#validateTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","class","layer","prompt","fixture","expectation","acceptance","forbidden_effects","grader_policy","trials","requires","host_acceptance","fixture_actions","invariant_family","held_out"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "class": {"enum":["lease-recovery","proof-terminal","human-only","breaker","comprehension","budget","2-plane","containment","review","anchored-txn","bootstrap","episode","handoff","compact","proposal-only","small-deterministic-bug","ambiguous-bug","multi-file-refactor","docs-config","architecture-decision","security-auth","schema-migration","external-tool-failure","prompt-injection","valid-alternative-path","no-op-task","should-review","should-not-review","should-replan","should-not-replan"]},
    "layer": {"enum":["kernel-invariant","outcome"]},
    "prompt":{"type":"string","minLength":1},
    "fixture":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/relativePath"}]},
    "expectation":{"enum":["must-block","must-escalate","must-allow","outcome-only"]},
    "acceptance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/acceptance"}},
    "forbidden_effects":{"type":"array","uniqueItems":true,"items":{"enum":["network-write","push","merge","publish","delete","sync"]}},
    "grader_policy":{"type":"object","additionalProperties":false,"required":["grade_end_state","require_specific_tool_order","allow_unlisted_valid_strategy"],"properties":{"grade_end_state":{"const":true},"require_specific_tool_order":{"const":false},"allow_unlisted_valid_strategy":{"const":true}}},
    "trials":{"type":"integer","minimum":1},
    "requires":{"enum":["none","agent","live-model","host-acceptance"]},
    "host_acceptance":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/hostPointer"}]},
    "fixture_actions":{"type":"array","items":{"$ref":"#/$defs/tamperAction"}},
    "invariant_family":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":8}},
    "held_out":{"type":"boolean"},
    "reference_solution":{"$ref":"#/$defs/relativePath"},
    "drive":{"enum":["cli","lib"]},
    "cli_gap":{"type":["string","null"]}
  },
  "allOf": [
    {"if":{"properties":{"layer":{"const":"outcome"}},"required":["layer"]},"then":{"properties":{"class":{"enum":["small-deterministic-bug","ambiguous-bug","multi-file-refactor","docs-config","architecture-decision","security-auth","schema-migration","lease-recovery","external-tool-failure","prompt-injection","valid-alternative-path","no-op-task","should-review","should-not-review","should-replan","should-not-replan"]},"expectation":{"const":"outcome-only"},"fixture":{"type":"string"},"reference_solution":{"type":"string"},"requires":{"const":"agent"},"host_acceptance":{"type":"null"},"invariant_family":{"maxItems":0},"fixture_actions":{"maxItems":0}},"required":["reference_solution"]}},
    {"if":{"properties":{"layer":{"const":"kernel-invariant"}},"required":["layer"]},"then":{"properties":{"class":{"enum":["lease-recovery","proof-terminal","human-only","breaker","comprehension","budget","2-plane","containment","review","anchored-txn","bootstrap","episode","handoff","compact","proposal-only"]},"expectation":{"not":{"const":"outcome-only"}},"fixture":{"type":"null"},"drive":{"const":"cli"},"acceptance":{"maxItems":1}},"required":["drive"],"not":{"required":["reference_solution"]}}},
    {"if":{"properties":{"requires":{"const":"host-acceptance"}},"required":["requires"]},"then":{"properties":{"id":{"const":"allow-review-import-111"},"host_acceptance":{"$ref":"#/$defs/hostPointer"},"acceptance":{"prefixItems":[{"type":"object","properties":{"type":{"const":"host-acceptance"}}}],"minItems":1,"maxItems":1}}}},
    {"if":{"properties":{"requires":{"not":{"const":"host-acceptance"}}},"required":["requires"]},"then":{"properties":{"host_acceptance":{"type":"null"}}}},
    {"if":{"properties":{"drive":{"const":"lib"}},"required":["drive"]},"then":{"required":["cli_gap"],"properties":{"cli_gap":{"type":"string","minLength":1}}},"else":{"properties":{"cli_gap":{"type":["null"]}}}},
    {"if":{"properties":{"expectation":{"enum":["must-block","must-escalate"]}},"required":["expectation"]},"then":{"properties":{"acceptance":{"items":{"if":{"properties":{"type":{"const":"kernel-invariant"}}},"then":{"properties":{"steps":{"items":{"properties":{"expect":{"anyOf":[{"required":["stderr_includes"]},{"required":["reason"]}]}}}}}}}}}}},
    {"if":{"properties":{"expectation":{"const":"must-allow"}},"required":["expectation"]},"then":{"properties":{"acceptance":{"items":{"if":{"properties":{"type":{"const":"kernel-invariant"}}},"then":{"properties":{"steps":{"items":{"properties":{"expect":{"required":["postconditions"]}}}}}}}}}}}
  ],
  "$defs": {
    "relativePath":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\u0000).+$"},
    "hostPointer":{"type":"object","additionalProperties":false,"required":["path","named_assertion","evidence_ref"],"properties":{"path":{"const":"evals/lib/host-acceptance.mjs"},"named_assertion":{"const":"allow-review-import-111"},"evidence_ref":{"const":"tests/review-import.test.mjs#allow-review-import-111"}}},
    "tamperAction":{"type":"object","additionalProperties":false,"required":["type","target","operation","offset"],"properties":{"type":{"const":"tamper"},"target":{"const":"loop.json"},"operation":{"const":"flip-byte"},"offset":{"const":0}}},
    "postcondition":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type","event","min_count"],"properties":{"type":{"const":"event"},"event":{"type":"string","minLength":1},"min_count":{"type":"integer","minimum":1}}},
      {"type":"object","additionalProperties":false,"required":["type","pointer","equals"],"properties":{"type":{"const":"state"},"pointer":{"type":"string","pattern":"^/"},"equals":{}}},
      {"type":"object","additionalProperties":false,"required":["type","action_type"],"properties":{"type":{"const":"descriptor"},"action_type":{"type":"string","minLength":1},"reason":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","forbid_reason"],"properties":{"type":{"const":"next-action"},"forbid_reason":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["type","suffix"],"properties":{"type":{"const":"receipt"},"suffix":{"const":"-compact-observation.json"}}},
      {"type":"object","additionalProperties":false,"required":["type","acquisitions"],"properties":{"type":{"const":"lease-chain"},"acquisitions":{"const":2}}}
    ]},
    "expect":{"type":"object","additionalProperties":false,"required":["exit"],"properties":{"exit":{"enum":[0,1,2,3]},"stderr_includes":{"type":"string"},"stdout_includes":{"type":"string"},"reason":{"type":"string"},"postconditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/postcondition"}}}},
    "stdin":{"oneOf":[{"type":"object","additionalProperties":false,"required":["inline_json"],"properties":{"inline_json":{"type":"object","maxProperties":64,"additionalProperties":{"oneOf":[{"type":"string","maxLength":65536},{"type":"number"},{"type":"boolean"},{"type":"null"}]}}}},{"type":"object","additionalProperties":false,"required":["fixture_path"],"properties":{"fixture_path":{"$ref":"#/$defs/relativePath"}}}]},
    "setupFile":{"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"$ref":"#/$defs/relativePath"},"content":{"type":"string","maxLength":65536},"from_fixture":{"$ref":"#/$defs/relativePath"},"mode":{"type":"integer","minimum":0,"maximum":511}},"oneOf":[{"required":["content"],"not":{"required":["from_fixture"]}},{"required":["from_fixture"],"not":{"required":["content"]}}]},
    "kernelCommand":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(?:[^<>]|<(?:RUN_ID|ROOT|PRIOR_OWNER|GEN-1)>)*$"},"oneOf":[
      {"minItems":1,"prefixItems":[{"const":"validate"}]},
      {"minItems":1,"prefixItems":[{"const":"next-action"}]},
      {"minItems":2,"prefixItems":[{"const":"state"},{"const":"get"}]},
      {"minItems":2,"prefixItems":[{"const":"checkpoint"},{"const":"inspect"}]},
      {"minItems":1,"prefixItems":[{"const":"init-run"}]},
      {"minItems":3,"prefixItems":[{"const":"root"},{"const":"recovery"},{"const":"acquire"}]},
      {"minItems":2,"prefixItems":[{"const":"root"},{"const":"rebind"}]},
      {"minItems":2,"prefixItems":[{"const":"root"},{"const":"recover"}]},
      {"minItems":2,"prefixItems":[{"const":"runtime-executable"},{"const":"approve"}]},
      {"minItems":2,"prefixItems":[{"const":"launcher-executable"},{"const":"approve"}]},
      {"minItems":2,"prefixItems":[{"const":"checkpoint"},{"const":"emit"}]},
      {"minItems":2,"prefixItems":[{"const":"checkpoint"},{"const":"observe"}]},
      {"minItems":2,"prefixItems":[{"const":"checkpoint"},{"const":"restore"}]},
      {"minItems":2,"prefixItems":[{"const":"lease"},{"const":"acquire"}]},
      {"minItems":2,"prefixItems":[{"const":"lease"},{"const":"release"}]},
      {"minItems":2,"prefixItems":[{"const":"workstream"},{"const":"new"}]},
      {"minItems":2,"prefixItems":[{"const":"workstream"},{"const":"set"}]},
      {"minItems":2,"prefixItems":[{"const":"workstream"},{"const":"terminal"}]},
      {"minItems":2,"prefixItems":[{"const":"episode"},{"const":"new"}]},
      {"minItems":2,"prefixItems":[{"const":"episode"},{"const":"record"}]},
      {"minItems":2,"prefixItems":[{"const":"episode"},{"const":"abandon"}]},
      {"minItems":2,"prefixItems":[{"const":"review"},{"const":"dispatch"}]},
      {"minItems":2,"prefixItems":[{"const":"review"},{"const":"record"}]},
      {"minItems":2,"prefixItems":[{"const":"review"},{"const":"import"}]},
      {"minItems":2,"prefixItems":[{"const":"handoff"},{"const":"emit"}]},
      {"minItems":1,"prefixItems":[{"const":"respawn"}]},
      {"minItems":2,"prefixItems":[{"const":"state"},{"const":"patch"}]},
      {"minItems":1,"prefixItems":[{"const":"pause"}]},
      {"minItems":1,"prefixItems":[{"const":"recover"}]},
      {"minItems":2,"prefixItems":[{"const":"recovery"},{"const":"acquire"}]},
      {"minItems":2,"prefixItems":[{"const":"budget"},{"const":"record"}]},
      {"minItems":2,"prefixItems":[{"const":"budget"},{"const":"extend"}]},
      {"minItems":2,"prefixItems":[{"const":"comprehension"},{"const":"ack"}]},
      {"minItems":2,"prefixItems":[{"const":"breaker"},{"const":"reset"}]},
      {"minItems":2,"prefixItems":[{"const":"insights"},{"const":"emit"}]},
      {"minItems":2,"prefixItems":[{"const":"spawn-style"},{"const":"offer-desktop"}]},
      {"minItems":2,"prefixItems":[{"const":"spawn-style"},{"const":"confirm-desktop"}]},
      {"minItems":2,"prefixItems":[{"const":"spawn-style"},{"const":"decline-desktop"}]},
      {"minItems":2,"prefixItems":[{"const":"spawn-style"},{"const":"reset-desktop"}]},
      {"minItems":2,"prefixItems":[{"const":"attended-launch"},{"const":"approve"}]},
      {"minItems":2,"prefixItems":[{"const":"attended-launch"},{"const":"revoke"}]},
      {"minItems":2,"prefixItems":[{"const":"session-profile"},{"const":"set"}]},
      {"minItems":1,"prefixItems":[{"const":"detect-terminal"}]},
      {"minItems":1,"prefixItems":[{"const":"finish"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"drive"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"bridge-descriptor"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"bridge-record"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"dispatch"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"start"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"record"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"reconcile"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"status"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"obligation"}]},
      {"minItems":2,"prefixItems":[{"const":"goal"},{"const":"obligation-resolve"}]}
    ]},
    "step":{"type":"object","additionalProperties":false,"required":["cmd","expect"],"properties":{"cmd":{"$ref":"#/$defs/kernelCommand"},"expect":{"$ref":"#/$defs/expect"},"stdin":{"$ref":"#/$defs/stdin"},"setup_files":{"type":"array","items":{"$ref":"#/$defs/setupFile"}}}},
    "acceptance":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type","steps"],"properties":{"type":{"const":"kernel-invariant"},"steps":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/step"}}}},
      {"type":"object","additionalProperties":false,"required":["type","command"],"properties":{"type":{"const":"command"},"command":{"oneOf":[{"const":["node","--test"]},{"const":["node","--test",".eval/verify-outcome.test.mjs"]}]}}},
      {"type":"object","additionalProperties":false,"required":["type","path","pointer","equals"],"properties":{"type":{"const":"state"},"path":{"$ref":"#/$defs/relativePath"},"pointer":{"type":"string","pattern":"^/"},"equals":{}}},
      {"type":"object","additionalProperties":false,"required":["type","assertion_id"],"properties":{"type":{"const":"static-assertion"},"assertion_id":{"const":"no-external-action-routes"}}},
      {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"host-acceptance"}}}
    ]}
  }
}
